msgid "Add BISS Key And Auto ADD MAP CAID To DVBAPI"
msgstr "إضافة مفتاح BISS وإضافة خريطة CAID تلقائيًا إلى DVBAPI"

msgid "Select Key Addition Method:"
msgstr "اختر طريقة إضافة المفتاح:"

msgid "Auto (DVBAPI)"
msgstr "تلقائي (DVBAPI)"

msgid "Manual (BISS)"
msgstr "يدوي (BISS)"

msgid "Exit"
msgstr "خروج"

msgid "Check Update"
msgstr "التحقق من التحديثات"

msgid "Press GREEN Key For Auto (DVBAPI): Only use this if the CW doesn't change (Freeze CW)"
msgstr "اضغط على المفتاح الأخضر للتلقائي (DVBAPI): استخدم هذا فقط إذا لم يتغير CW (ثبات CW)"

msgid "Press YELLOW Key For ADD Manual BISS Key"
msgstr "اضغط على المفتاح الأصفر لإضافة مفتاح BISS يدويًا"

msgid "Press BLUE Key To Check Update"
msgstr "اضغط على المفتاح الأزرق للتحقق من التحديثات"

msgid "Press RED Key To Exit Plugin"
msgstr "اضغط على المفتاح الأحمر للخروج من البلجن"

msgid "SNR"
msgstr "جودة الإشارة"

msgid "AGC"
msgstr "قوة الإشارة"

msgid "Freq: %s | Pol: %s | FEC: %s | SR: %s"
msgstr "التردد: %s | الاستقطاب: %s | تصحيح الخطأ: %s | معدل الترميز: %s"

msgid "Channel info not available"
msgstr "معلومات القناة غير متوفرة"

msgid "Update already installed!\nPlease Restart Enigma2 to Complete Update."
msgstr "التحديث مثبت بالفعل!\nيرجى إعادة تشغيل Enigma2 لإكمال التحديث."

msgid "New update available"
msgstr "يوجد تحديث جديد متاح"

msgid "No updates available"
msgstr "لا توجد تحديثات متاحة"

msgid "Checking channel encryption..."
msgstr "جارٍ التحقق من تشفير القناة..."

msgid "No active service!\nPlease tune to a channel first."
msgstr "لا توجد خدمة نشطة!\nيرجى الوقوف على قناة أولاً."

msgid "Could not get service info"
msgstr "تعذر الحصول على معلومات الخدمة"

msgid "Channel is not encrypted\nor CAID not available"
msgstr "القناة غير مشفرة\nأو CAID غير متوفر"

msgid "Could not get SID"
msgstr "تعذر الحصول على SID"

msgid "Found encrypted channel\nCAID: %s\nSID: %s"
msgstr "تم العثور على قناة مشفرة\nCAID: %s\nSID: %s"

msgid "Key added successfully!\nCAID: %s\nSID: %s"
msgstr "تم إضافة المفتاح بنجاح!\nCAID: %s\nSID: %s"

msgid "Key added but emulator not restarted"
msgstr "تم إضافة المفتاح ولكن لم يتم إعادة تشغيل المحاكي"

msgid "Failed to write to dvbapi file"
msgstr "فشل الكتابة في ملف dvbapi"

msgid "Enter EXACTLY 16 character BISS Key (0-9,A-F):"
msgstr "أدخل مفتاح BISS المكون من 16 حرفًا بالضبط (0-9, A-F):"

msgid "Key is too short! (%s/16 chars)\nNeed %s more characters."
msgstr "المفتاح قصير جدًا! (%s/16 حرفًا)\nتحتاج إلى %s أحرف إضافية."

msgid "Key is too long! (%s/16 chars)\nRemove %s characters."
msgstr "المفتاح طويل جدًا! (%s/16 حرفًا)\nقم بإزالة %s أحرف."

msgid "Invalid characters!\nOnly 0-9 and A-F are allowed."
msgstr "أحرف غير صالحة!\nيُسمح فقط بـ 0-9 و A-F."

msgid "Processing BISS key..."
msgstr "جارٍ معالجة مفتاح BISS..."

msgid "BISS key added!\nSID: %s\nVPID: %s"
msgstr "تم إضافة مفتاح BISS!\nSID: %s\nVPID: %s"

msgid "Failed to write to SoftCam.Key"
msgstr "فشل الكتابة في ملف SoftCam.Key"

msgid "Required packages not installed!\nPlease install manually:\n"
msgstr "الحزم المطلوبة غير مثبتة!\nيرجى التثبيت يدويًا:\n"
